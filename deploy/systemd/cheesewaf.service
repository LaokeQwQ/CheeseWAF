[Unit]
Description=CheeseWAF
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cheesewaf
Group=cheesewaf
WorkingDirectory=/var/lib/cheesewaf
Environment=CHEESEWAF_WEB_DIR=/usr/share/cheesewaf/web
ExecStart=/usr/local/bin/cheesewaf serve --config /etc/cheesewaf/cheesewaf.yaml --data-dir /var/lib/cheesewaf
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576
# systemd applies these while still privileged, then drops to User=.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/cheesewaf /var/log/cheesewaf

[Install]
WantedBy=multi-user.target
