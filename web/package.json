{
  "name": "cheesewaf-web",
  "private": true,
  "version": "0.3.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-china-admin-index.mjs",
    "build": "tsc -b && vite build && node scripts/verify-build-budget.mjs",
    "build:china-admin-index": "node scripts/build-china-admin-index.mjs",
    "pack:gaode-world": "node scripts/pack-gaode-world.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "test:scripts": "node --test --test-concurrency=1 scripts/*.test.mjs",
    "test:captcha-contract": "node --test --test-concurrency=1 ../scripts/e2e/captcha-lab/lab-page.test.mjs ../scripts/e2e/captcha-integration/fixture-client.test.mjs",
    "test:e2e-contracts": "node --test --test-concurrency=1 ../scripts/e2e/captcha-lab/lab-page.test.mjs ../scripts/e2e/captcha-lab/interactions/range.test.mjs ../scripts/e2e/captcha-lab/interactions/surface.test.mjs ../scripts/e2e/captcha-lab/interactions/click.test.mjs ../scripts/e2e/captcha-lab/fixed-harness.test.mjs ../scripts/e2e/captcha-lab/private-harness.test.mjs ../scripts/e2e/captcha-integration/fixture-client.test.mjs ../scripts/e2e/captcha-integration/browser-monitor.test.mjs ../scripts/e2e/captcha-integration/runtime.test.mjs ../scripts/e2e/captcha-integration/captcha-lab-flow.test.mjs",
    "e2e:captcha": "npm run test:captcha-contract && node --test --test-concurrency=1 ../scripts/e2e/captcha-lab/interactions/range.test.mjs ../scripts/e2e/captcha-lab/interactions/surface.test.mjs ../scripts/e2e/captcha-lab/interactions/click.test.mjs ../scripts/e2e/captcha-lab/fixed-harness.test.mjs ../scripts/e2e/captcha-lab/private-harness.test.mjs ../scripts/e2e/captcha-integration/browser-monitor.test.mjs ../scripts/e2e/captcha-integration/runtime.test.mjs ../scripts/e2e/captcha-integration/captcha-lab-flow.test.mjs && node ../scripts/e2e/captcha-integration/run.mjs --profile desktop && node ../scripts/e2e/captcha-lab/run-local.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "dompurify": "^3.4.14",
    "i18next": "^26.4.0",
    "lucide-react": "^1.33.0",
    "maplibre-gl": "^6.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
