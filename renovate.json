{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "Asia/Shanghai",
  "labels": [
    "dependencies",
    "security"
  ],
  "baseBranches": [
    "dev"
  ],
  "enabledManagers": [
    "dockerfile"
  ],
  "rangeStrategy": "bump",
  "prConcurrentLimit": 5,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "priority-high"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": false
    }
  ],
  "schedule": [
    "before 06:00 on tuesday"
  ]
}
